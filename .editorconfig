root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,csproj,props,slnx,ts,tsx,js,jsx,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Descriptive Method_does_something_when_x names are the convention for test methods.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none

# EF Core migrations are generated; analyzers and style rules do not apply to them.
[**/Persistence/Migrations/*.cs]
generated_code = true
