  },
  "components": {
    "schemas": {
      "AccountListResponse": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountSummary"
            }
          }
        }
      },
      "AccountStatus": {
        "enum": [
          "active",
          "suspended",
          "closed"
        ],
        "type": "string"
      },
      "AccountSummary": {
        "required": [
          "id",
          "name",
          "type",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/AccountType"
          },
          "status": {
            "$ref": "#/components/schemas/AccountStatus"
          }
        }
      },
      "AccountType": {
        "enum": [
          "personal",
          "organization"
        ],
        "type": "string"
      },
      "CapabilitiesResponse": {
        "required": [
          "accountId",
          "calculatedAt",
          "validUntil",
          "capabilities"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "calculatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapabilityDto"
            }
          }
        }
      },
      "CapabilityDto": {
        "required": [
          "key",
          "kind",
          "granted",
          "limit"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/CapabilityKind"
          },
          "granted": {
            "type": "boolean"
          },
          "limit": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CapabilityLimitDto"
              }
            ]
          }
        }
      },
      "CapabilityKind": {
        "enum": [
          "feature",
          "limit"
        ],
        "type": "string"
      },
      "CapabilityLimitDto": {
        "required": [
          "isUnlimited",
          "value"
        ],
        "type": "object",
        "properties": {
          "isUnlimited": {
            "type": "boolean"
          },
          "value": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "CreateProjectRequest": {
        "required": [
          "name",
          "description"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "HttpValidationProblemDetails": {
        "required": [
          "code",
          "correlationId",
          "status"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "code": {
            "enum": [
              "bad_request",
              "capability_not_granted",
              "conflict",
              "forbidden",
              "internal_error",
              "invalid_credentials",
              "not_found",
              "not_implemented",
              "quota_exceeded",
              "rate_limited",
              "registration_failed",
              "service_unavailable",
              "unauthenticated",
              "validation_failed"
            ],
            "type": "string",
            "description": "Stable machine-readable error code."
          },
          "correlationId": {
            "type": "string",
            "description": "Identifies the request in the server logs; quote it when reporting a problem."
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "required": [
          "accessToken",
          "tokenType",
          "expiresAt",
          "user"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        }
      },
      "ProblemDetails": {
        "required": [
          "code",
          "correlationId",
          "status"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "code": {
            "enum": [
              "bad_request",
              "capability_not_granted",
              "conflict",
              "forbidden",
              "internal_error",
              "invalid_credentials",
              "not_found",
              "not_implemented",
              "quota_exceeded",
              "rate_limited",
              "registration_failed",
              "service_unavailable",
              "unauthenticated",
              "validation_failed"
            ],
            "type": "string",
            "description": "Stable machine-readable error code."
          },
          "correlationId": {
            "type": "string",
            "description": "Identifies the request in the server logs; quote it when reporting a problem."
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "ProjectDto": {
        "required": [
          "id",
          "accountId",
          "name",
          "description",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProjectListResponse": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectDto"
            }
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RegisterResponse": {
        "required": [
          "user",
          "personalAccount"
        ],
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto"
          },
          "personalAccount": {
            "$ref": "#/components/schemas/AccountSummary"
          }
        }
      },
      "UserDto": {
        "required": [
          "id",
          "email",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Me"
    },
    {
      "name": "Accounts"
    },
    {
      "name": "Projects"
    }
  ]
}