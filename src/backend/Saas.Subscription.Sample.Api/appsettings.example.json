{
  "Database": {
    "ConnectionString": "<postgres-connection-string-with-SSL-Mode=VerifyFull>",
    "CommandTimeoutSeconds": 30,
    "MaxPoolSize": 20
  },
  "Authentication": {
    "Issuer": "<token-issuer>",
    "Audience": "<token-audience>",
    "AccessTokenLifetime": "00:10:00",
    "SigningKey": "<signing-key-secret>",
    "SigningKeyId": "<signing-key-id>"
  },
  "Billing": {
    "Provider": "Simulator",
    "Simulator": {
      "ControlsEnabled": false
    },
    "Stripe": {
      "SecretKey": "<stripe-sandbox-secret-key>",
      "WebhookSecret": "<stripe-webhook-signing-secret>"
    }
  },
  "Email": {
    "Provider": "Https",
    "FromAddress": "<sender@example.com>",
    "FromName": "<sender-display-name>",
    "Smtp": {
      "Host": "<smtp-host>",
      "Port": 1025
    },
    "Https": {
      "ApiKey": "<email-provider-api-key>"
    }
  },
  "Cache": {
    "Provider": "Memory",
    "KeyPrefix": "<environment-specific-prefix>",
    "Redis": {
      "ConnectionString": "<redis-connection-string>"
    }
  },
  "Frontend": {
    "BaseUrl": "<https://app.example.com>",
    "AllowedOrigins": [
      "<https://app.example.com>"
    ]
  },
  "BackgroundWork": {
    "Enabled": true,
    "PollInterval": "00:00:05",
    "LeaseDuration": "00:01:00",
    "BatchSize": 10,
    "MaxAttempts": 5
  }
}
