{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Issuer": "saas-subscription-sample",
    "Audience": "saas-subscription-sample-api",
    "AccessTokenLifetime": "00:10:00"
  },
  "Billing": {
    "Provider": "Simulator",
    "Simulator": {
      "ControlsEnabled": false
    }
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "no-reply@saas-sample.invalid",
    "FromName": "Subscription Lab"
  },
  "Cache": {
    "Provider": "Memory",
    "KeyPrefix": "saas-sample"
  },
  "BackgroundWork": {
    "Enabled": true,
    "PollInterval": "00:00:05",
    "LeaseDuration": "00:01:00",
    "BatchSize": 10,
    "MaxAttempts": 5
  }
}
