{
  "name": "saas-subscription-sample-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "contract:generate": "dotnet build ../backend/Saas.Subscription.Sample.Api -p:GenerateOpenApiContract=true && npm run contract:types",
    "contract:types": "openapi-typescript ../../docs/contracts/openapi.json -o src/api/schema.d.ts",
    "contract:check": "openapi-typescript ../../docs/contracts/openapi.json -o src/api/schema.d.ts --check"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.81.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.13.0",
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
